---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Ruta de navegación" class="border-b border-line bg-surface">
  <ol class="container-xl flex h-14 items-center gap-3 overflow-hidden text-body-sm text-content-subtle">
    {items.map((item, index) => (
      <li class="flex min-w-0 items-center gap-3">
        {index > 0 && <span aria-hidden="true">›</span>}
        {item.href ? (
          <a href={item.href} class="shrink-0 transition-colors hover:text-accent">{item.label}</a>
        ) : (
          <span class="truncate text-content" aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
