---
import client from "../../../tina/__generated__/client";

const result = await client.queries.global({ relativePath: "index.json" });
const whatsapp = result.data?.global?.whatsapp;

const message = encodeURIComponent(whatsapp?.message || "Hola Aprendly");
const phone = (whatsapp?.phone || "").replace(/\D/g, "");
const href = `https://wa.me/${phone}?text=${message}`;
---

{whatsapp?.enabled && (
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Escríbenos por WhatsApp"
    class="group fixed bottom-5 right-5 z-[70] flex items-center gap-3 md:bottom-8 md:right-8"
  >
    {whatsapp?.bubbleTitle && (
      <span class="whatsapp-bubble hidden flex-col rounded-[18px] bg-white px-4 py-3 shadow-card sm:flex">
        <span class="text-caption-md font-semibold text-content">{whatsapp.bubbleTitle}</span>
        {whatsapp.bubbleText && <span class="text-caption-sm text-content-subtle">{whatsapp.bubbleText}</span>}
      </span>
    )}
    <span class="h-14 w-14 rounded-full shadow-[0_14px_30px_rgba(81,200,89,.4)] transition-transform duration-300 ease-out-expo group-hover:scale-110 md:h-16 md:w-16">
      <img src="/images/whatsapp.svg" alt="" class="block h-full w-full" width="64" height="64" />
    </span>
  </a>
)}

<style>
  .whatsapp-bubble {
    animation: bubble-in 450ms cubic-bezier(0.16, 1, 0.3, 1) 2.5s both;
  }
  @keyframes bubble-in {
    from { opacity: 0; transform: translateX(16px); }
    to { opacity: 1; transform: translateX(0); }
  }
</style>
