{
  "formId": "propuesta-empresas",
  "formTitle": "",
  "description": "Cuéntanos sobre tu organización y te enviamos una propuesta a la medida.",
  "styleVariant": "contact",
  "submitButtonText": "Solicitar propuesta",
  "successTitle": "¡Gracias! Recibimos tu solicitud.",
  "successMessage": "Un asesor corporativo te contactará en las próximas 24 horas con una propuesta a la medida.",
  "errorMessage": "Ocurrió un error al enviar. Inténtalo de nuevo.",
  "validationMessage": "Por favor completa los campos obligatorios.",
  "showCorrelativo": false,
  "privacyText": "Te respondemos en menos de 24 horas.",
  "fields": [
    {
      "fieldType": "radio",
      "name": "tipoOrganizacion",
      "label": "Tipo de organización",
      "required": true,
      "width": "full",
      "order": 1,
      "defaultValue": "empresa",
      "options": [
        { "value": "empresa", "label": "Empresa" },
        { "value": "institucion", "label": "Institución educativa" }
      ]
    },
    {
      "fieldType": "text",
      "name": "nombre",
      "label": "Nombre y apellido",
      "placeholder": "Nombre y apellido",
      "required": true,
      "width": "full",
      "order": 2
    },
    {
      "fieldType": "text",
      "name": "organizacion",
      "label": "Empresa o institución",
      "placeholder": "Empresa o institución",
      "required": true,
      "width": "full",
      "order": 3
    },
    {
      "fieldType": "email",
      "name": "correo",
      "label": "Correo corporativo",
      "placeholder": "Correo corporativo",
      "required": true,
      "width": "full",
      "order": 4
    },
    {
      "fieldType": "text",
      "name": "telefono",
      "label": "Teléfono",
      "placeholder": "Teléfono",
      "required": false,
      "width": "half",
      "order": 5,
      "validation": {
        "pattern": "^[0-9+()\\s-]{6,20}$",
        "patternMessage": "Ingresa un teléfono válido"
      }
    },
    {
      "fieldType": "select",
      "name": "tamano",
      "label": "Tamaño del equipo",
      "placeholder": "Tamaño del equipo",
      "required": true,
      "width": "half",
      "order": 6,
      "options": [
        { "value": "1-20", "label": "1 – 20" },
        { "value": "21-100", "label": "21 – 100" },
        { "value": "101-500", "label": "101 – 500" },
        { "value": "500+", "label": "500+" }
      ]
    },
    {
      "fieldType": "textarea",
      "name": "mensaje",
      "label": "Mensaje",
      "placeholder": "Cuéntanos tu objetivo (opcional)",
      "required": false,
      "width": "full",
      "rows": 3,
      "order": 7
    }
  ]
}
