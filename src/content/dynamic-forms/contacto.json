{
  "formId": "contacto",
  "formTitle": "",
  "description": "Cuéntanos qué necesitas y un asesor te responde en menos de 24 horas.",
  "styleVariant": "contact",
  "submitButtonText": "Enviar mensaje",
  "successTitle": "¡Mensaje enviado!",
  "successMessage": "Un asesor te contactará en las próximas 24 horas.",
  "errorMessage": "Ocurrió un error al enviar. Inténtalo de nuevo.",
  "validationMessage": "Por favor completa los campos obligatorios.",
  "showCorrelativo": false,
  "privacyText": "Al enviar aceptas nuestra política de privacidad.",
  "fields": [
    {
      "fieldType": "radio",
      "name": "paraQuien",
      "label": "¿Para quién es?",
      "required": true,
      "width": "full",
      "order": 1,
      "defaultValue": "mi",
      "options": [
        { "value": "mi", "label": "Para mí" },
        { "value": "empresa", "label": "Mi empresa" },
        { "value": "institucion", "label": "Mi institución" }
      ]
    },
    {
      "fieldType": "text",
      "name": "nombre",
      "label": "Nombre y apellido",
      "placeholder": "Nombre y apellido",
      "required": true,
      "width": "half",
      "order": 2
    },
    {
      "fieldType": "text",
      "name": "telefono",
      "label": "Teléfono",
      "placeholder": "Teléfono",
      "required": false,
      "width": "half",
      "order": 3,
      "validation": {
        "pattern": "^[0-9+()\\s-]{6,20}$",
        "patternMessage": "Ingresa un teléfono válido"
      }
    },
    {
      "fieldType": "email",
      "name": "correo",
      "label": "Correo electrónico",
      "placeholder": "Correo electrónico",
      "required": true,
      "width": "full",
      "order": 4
    },
    {
      "fieldType": "text",
      "name": "empresa",
      "label": "Empresa",
      "placeholder": "Empresa",
      "required": true,
      "width": "half",
      "order": 5,
      "conditionalField": { "dependsOn": "paraQuien", "showWhen": "empresa" }
    },
    {
      "fieldType": "select",
      "name": "colaboradores",
      "label": "Número de colaboradores",
      "placeholder": "Elige un número de colaboradores",
      "required": false,
      "width": "half",
      "order": 6,
      "conditionalField": { "dependsOn": "paraQuien", "showWhen": "empresa" },
      "options": [
        { "value": "1-20", "label": "1 – 20" },
        { "value": "21-100", "label": "21 – 100" },
        { "value": "101-500", "label": "101 – 500" },
        { "value": "500+", "label": "500+" }
      ]
    },
    {
      "fieldType": "text",
      "name": "institucion",
      "label": "Institución educativa",
      "placeholder": "Institución educativa",
      "required": true,
      "width": "half",
      "order": 7,
      "conditionalField": { "dependsOn": "paraQuien", "showWhen": "institucion" }
    },
    {
      "fieldType": "select",
      "name": "alumnos",
      "label": "Número de alumnos",
      "placeholder": "Elige un número de alumnos",
      "required": false,
      "width": "half",
      "order": 8,
      "conditionalField": { "dependsOn": "paraQuien", "showWhen": "institucion" },
      "options": [
        { "value": "1-20", "label": "1 – 20" },
        { "value": "21-100", "label": "21 – 100" },
        { "value": "101-500", "label": "101 – 500" },
        { "value": "500+", "label": "500+" }
      ]
    },
    {
      "fieldType": "textarea",
      "name": "mensaje",
      "label": "Mensaje",
      "placeholder": "¿En qué te podemos ayudar?",
      "required": true,
      "width": "full",
      "rows": 4,
      "order": 9
    },
    {
      "fieldType": "hidden",
      "name": "interes",
      "label": "Interés",
      "required": false,
      "width": "full",
      "order": 10
    }
  ]
}
