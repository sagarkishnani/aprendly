---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLink from "../components/ui/ArrowLink";
import Eyebrow from "../components/ui/Eyebrow";

const base = import.meta.env.BASE_URL || "/";
---

<BaseLayout title="Página no encontrada · Aprendly" noindex>
  <section class="flex min-h-[70vh] items-center bg-surface-tint py-20">
    <div class="container-xl text-center">
      <Eyebrow variant="pink" tilted>Error 404</Eyebrow>
      <h1 class="mx-auto mt-6 max-w-2xl text-heading-xl">Esta página se fue de intercambio.</h1>
      <p class="mx-auto mt-5 max-w-md text-body-lg text-content-muted">
        Puede que el enlace esté roto o que la página se haya movido. Te ayudamos a volver a tu ruta.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <ArrowLink href={base} size="lg">Volver al inicio</ArrowLink>
        <ArrowLink href={`${base}cursos`} variant="outline" size="lg">Ver cursos</ArrowLink>
      </div>
    </div>
  </section>
</BaseLayout>
