---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactoHero from "../components/contacto/ContactoHero.astro";
import Faq from "../components/contacto/Faq.astro";
import client from "../../tina/__generated__/client";
import { loadWhatsappHref } from "../components/eventos/whatsappHref";

const result = await client.queries.contactoPage({ relativePath: "index.json" });
const { query, variables, data } = result;
const seo = (data as any)?.contactoPage?.seo;
const whatsappHref = await loadWhatsappHref();
---

<BaseLayout title={seo?.title} description={seo?.description}>
  <ContactoHero query={query} variables={variables} data={data} whatsappHref={whatsappHref} />
  <Faq query={query} variables={variables} data={data} />
</BaseLayout>
