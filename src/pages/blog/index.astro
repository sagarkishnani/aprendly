---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/blog/Breadcrumb.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import Eyebrow from "../../components/ui/Eyebrow";
import ArrowLink from "../../components/ui/ArrowLink";
import client from "../../../tina/__generated__/client";
import { getLocale, tField } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
const base = import.meta.env.BASE_URL || "/";
const prefix = locale === "es" ? base : `${base}${locale}/`;

const result = await client.queries.postConnection();
const posts = (result.data?.postConnection?.edges || [])
  .map((edge: any) => edge?.node)
  .filter(Boolean)
  .sort((a: any, b: any) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime());
---

<BaseLayout title="Blog — Aprendly" description="Consejos, guías y novedades para aprender inglés con propósito.">
  <Breadcrumb items={[{ label: "Inicio", href: prefix }, { label: "Blog" }]} />

  <section class="bg-surface pb-12 pt-14 md:pb-16 md:pt-[72px]">
    <div class="container-xl flex flex-col justify-between gap-6 lg:flex-row lg:items-end lg:gap-16">
      <div>
        <Eyebrow variant="lavender" tilted className="mb-5" data-reveal="up">Blog</Eyebrow>
        <h1 class="max-w-[640px] text-heading-xl" data-reveal="up" data-delay="80">Ideas para aprender inglés con propósito.</h1>
      </div>
      <p class="max-w-[420px] text-[17px] leading-[1.65] text-content-muted" data-reveal="up" data-delay="160">
        Guías prácticas, consejos de nuestros profesores y novedades de Aprendly. ¿Quieres saber tu nivel?
        <a href={`${prefix}ruta-de-aprendizaje`} class="font-semibold text-accent hover:text-brand-primary-dark">Haz tu diagnóstico gratis.</a>
      </p>
    </div>
  </section>

  <section class="bg-surface-tint pb-20 pt-12 md:pb-[120px] md:pt-14">
    <div class="container-xl">
      {posts.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post: any) => (
            <BlogCard
              href={`${prefix}blog/${post._sys.filename}`}
              title={tField(post, "title", locale)}
              excerpt={tField(post, "excerpt", locale)}
              coverImage={post.coverImage}
              date={post.date}
              readTime={post.readTime}
              tags={post.tags}
              featured={post.featured}
              locale={locale}
            />
          ))}
        </div>
      ) : (
        <div class="rounded-[28px] bg-surface px-6 py-16 text-center">
          <p class="mb-6 text-subtitle-lg">Muy pronto publicaremos nuestros primeros artículos.</p>
          <ArrowLink href={`${prefix}cursos`}>Ver cursos</ArrowLink>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
